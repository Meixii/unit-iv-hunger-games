---
// Interactive Neural Network Architecture Visualizer
// 41 Inputs (5 Internal + 36 Moore Sensory) -> 16 Hidden 1 (ReLU) -> 12 Hidden 2 (ReLU) -> 8 Outputs
---

<div class="nn-visualizer card">
  <div class="nn-header">
    <div class="nn-title">Multi-Layer Perceptron Topology (41-16-12-8)</div>
    <div class="nn-legend">
      <span class="legend-pill sensory"><span class="dot"></span> Sensory (41)</span>
      <span class="legend-pill hidden"><span class="dot"></span> Hidden (16 & 12)</span>
      <span class="legend-pill output"><span class="dot"></span> Motor Output (8)</span>
    </div>
  </div>

  <div class="layers-grid">
    <!-- Input Layer -->
    <div class="layer-column">
      <div class="layer-label">Input Layer (41)</div>
      <div class="layer-sub">5 Internal + 36 Grid</div>
      <div class="node-stack">
        <div class="node-pill internal" title="Health % [0.0 - 1.0]">Health %</div>
        <div class="node-pill internal" title="Hunger % [0.0 - 1.0]">Hunger %</div>
        <div class="node-pill internal" title="Thirst % [0.0 - 1.0]">Thirst %</div>
        <div class="node-pill internal" title="Energy % [0.0 - 1.0]">Energy %</div>
        <div class="node-pill internal" title="Instinct [0 = Calm, 1 = Alert]">Instinct</div>
        <div class="node-divider">Moore 3x3 Sensory Grid</div>
        <div class="node-pill sensory" title="9 Threat Nodes (Fire, Flood, Trap)">Threats (9 nodes)</div>
        <div class="node-pill sensory" title="9 Food Nodes (Plant, Prey)">Food (9 nodes)</div>
        <div class="node-pill sensory" title="9 Water Nodes">Water (9 nodes)</div>
        <div class="node-pill sensory" title="9 Animal Rival Nodes">Animals (9 nodes)</div>
      </div>
    </div>

    <div class="connector-arrow" aria-hidden="true">→</div>

    <!-- Hidden Layer 1 -->
    <div class="layer-column">
      <div class="layer-label">Hidden Layer 1 (16)</div>
      <div class="layer-sub">Activation: ReLU</div>
      <div class="node-stack center-stack">
        <div class="nodes-cluster">
          {Array.from({ length: 16 }).map((_, i) => (
            <div class="node-circle" title={`Neuron H1-${i + 1}`}>H1.{i + 1}</div>
          ))}
        </div>
        <div class="layer-role-note">Feature synthesis: sensory-vital correlation patterns</div>
      </div>
    </div>

    <div class="connector-arrow" aria-hidden="true">→</div>

    <!-- Hidden Layer 2 -->
    <div class="layer-column">
      <div class="layer-label">Hidden Layer 2 (12)</div>
      <div class="layer-sub">Activation: ReLU</div>
      <div class="node-stack center-stack">
        <div class="nodes-cluster">
          {Array.from({ length: 12 }).map((_, i) => (
            <div class="node-circle h2-node" title={`Neuron H2-${i + 1}`}>H2.{i + 1}</div>
          ))}
        </div>
        <div class="layer-role-note">Behavioral arbitration: resolve hunger vs threat flight</div>
      </div>
    </div>

    <div class="connector-arrow" aria-hidden="true">→</div>

    <!-- Output Layer -->
    <div class="layer-column">
      <div class="layer-label">Output Layer (8)</div>
      <div class="layer-sub">Argmax Action Select</div>
      <div class="node-stack">
        <div class="node-pill output" title="Translate 1 cell North">Move North</div>
        <div class="node-pill output" title="Translate 1 cell East">Move East</div>
        <div class="node-pill output" title="Translate 1 cell South">Move South</div>
        <div class="node-pill output" title="Translate 1 cell West">Move West</div>
        <div class="node-pill output action-bio" title="Consume Plant or Prey on current cell">Eat / Forage</div>
        <div class="node-pill output action-bio" title="Quench thirst at adjacent water cell">Drink Water</div>
        <div class="node-pill output action-neutral" title="Conserve energy & regenerate stamina">Rest / Conserve</div>
        <div class="node-pill output action-combat" title="Strike rival organism on adjacent cell">Attack / Defend</div>
      </div>
    </div>
  </div>
</div>

<style>
  .nn-visualizer {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    margin: 2rem 0;
  }
  .nn-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
  }
  .nn-title {
    font-weight: 700;
    font-size: 1.0625rem;
    color: var(--text-primary);
  }
  .nn-legend {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .legend-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-secondary);
  }
  .legend-pill .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }
  .legend-pill.sensory .dot { background: var(--accent-neural); }
  .legend-pill.hidden .dot { background: var(--border-active); }
  .legend-pill.output .dot { background: var(--accent-bio); }

  .layers-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
    align-items: center;
    gap: 0.75rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
  }
  .layer-column {
    background: var(--bg-canvas);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1rem;
    min-width: 170px;
  }
  .layer-label {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--text-primary);
    text-align: center;
  }
  .layer-sub {
    font-size: 0.6875rem;
    color: var(--text-muted);
    text-align: center;
    margin-bottom: 0.75rem;
  }
  .node-stack {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .node-pill {
    font-size: 0.75rem;
    padding: 0.35rem 0.6rem;
    border-radius: var(--radius-xs);
    border: 1px solid var(--border-subtle);
    background: var(--bg-surface);
    color: var(--text-secondary);
    text-align: center;
    font-weight: 500;
    transition: all var(--duration-fast) var(--ease-out);
  }
  .node-pill:hover {
    border-color: var(--border-highlight);
    color: var(--text-primary);
  }
  .node-pill.internal {
    border-left: 2px solid var(--accent-neural);
  }
  .node-pill.sensory {
    border-left: 2px solid var(--accent-hazard);
  }
  .node-pill.output {
    border-left: 2px solid var(--accent-bio);
  }
  .node-pill.action-combat {
    border-left: 2px solid var(--accent-perish);
  }
  .node-divider {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    text-align: center;
    margin: 0.25rem 0;
  }

  .connector-arrow {
    font-size: 1.25rem;
    color: var(--border-highlight);
    user-select: none;
  }

  .nodes-cluster {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.35rem;
    justify-content: center;
  }
  .node-circle {
    font-size: 0.625rem;
    font-family: var(--font-mono);
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--bg-surface-raised);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: default;
    transition: border-color var(--duration-fast) var(--ease-out);
  }
  .node-circle:hover {
    border-color: var(--accent-neural);
    color: var(--text-primary);
  }
  .node-circle.h2-node {
    border-color: var(--border-subtle);
  }
  .node-circle.h2-node:hover {
    border-color: var(--accent-bio);
  }
  .layer-role-note {
    font-size: 0.6875rem;
    color: var(--text-muted);
    text-align: center;
    margin-top: 0.75rem;
    line-height: 1.3;
  }

  @media (max-width: 900px) {
    .layers-grid {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }
    .connector-arrow {
      transform: rotate(90deg);
    }
    .layer-column {
      width: 100%;
    }
  }
</style>
