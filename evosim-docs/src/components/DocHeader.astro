---
import { siteData } from "../lib/content";
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="app-header">
  <div class="header-left">
    <button id="mobile-menu-toggle" class="menu-toggle" type="button" aria-label="Toggle navigation menu">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
    <a href="/" class="brand-link">
      <span class="brand-dot" aria-hidden="true"></span>
      <span>{siteData.identity.shortName}</span>
      <span class="brand-version">v{siteData.identity.version}</span>
    </a>
  </div>

  <div class="header-right">
    <button id="search-modal-trigger" class="search-trigger" type="button" aria-label="Search documentation">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <span>Search docs</span>
      <kbd class="search-kbd">Ctrl K</kbd>
    </button>

    <a href={siteData.links.github} target="_blank" rel="noopener noreferrer" class="header-icon-link" aria-label="View on GitHub">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
      </svg>
    </a>

    <ThemeToggle />
  </div>
</header>

<style>
  .header-icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    width: 38px;
    height: 38px;
    transition: all var(--duration-fast) var(--ease-out);
  }
  .header-icon-link:hover {
    background: var(--bg-surface-raised);
    color: var(--text-primary);
    border-color: var(--border-highlight);
  }
</style>

<script>
  function setupHeader() {
    const toggle = document.getElementById("mobile-menu-toggle");
    const sidebar = document.querySelector(".sidebar-container");
    if (toggle && sidebar) {
      toggle.onclick = () => {
        sidebar.classList.toggle("open");
      };
    }
  }
  setupHeader();
  document.addEventListener("astro:page-load", setupHeader);
</script>
