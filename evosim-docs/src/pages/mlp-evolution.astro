---
import BaseLayout from "../layouts/BaseLayout.astro";
import NeuralNetVisualizer from "../components/NeuralNetVisualizer.astro";
import { mlpEvolutionData } from "../lib/content";

const headings = [
  { id: "mlp-topology", text: "Neural Network Architecture" },
  { id: "sensory-grid", text: "Moore Neighborhood Perception Vector" },
  { id: "hidden-layers", text: "Processing & Hidden Layers" },
  { id: "output-actions", text: "Motor Output Actions" },
  { id: "genetic-algorithm", text: "Evolutionary Algorithm Pipeline" },
];
---

<BaseLayout
  title={mlpEvolutionData.title}
  description={mlpEvolutionData.lede}
  category="Core Concepts"
  headings={headings}
>
  <h2 id="mlp-topology">Neural Network Architecture</h2>
  <p>{mlpEvolutionData.mlp.summary}</p>

  <NeuralNetVisualizer />

  <div class="figure-container">
    <img 
      src="/images/neural_architecture_diagram.png" 
      alt="41-16-12-8 Feedforward MLP Neuroevolution Architecture" 
      class="figure-image"
      loading="lazy"
    />
    <div class="figure-caption">
      <span><strong>Figure 4.1:</strong> Complete 4-layer feedforward neural topology (41 Input → 16 Hidden L1 → 12 Hidden L2 → 8 Motor Softmax).</span>
      <span class="badge">MLP Architecture</span>
    </div>
  </div>

  <h2 id="sensory-grid">Moore Neighborhood Perception Vector</h2>
  <p>
    The input vector comprises <strong>41 normalized floating-point values</strong> (scaled to [0.0, 1.0]). It combines 5 internal vitals with a 36-element sensory perception matrix representing the 3x3 grid centered on the agent:
  </p>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Input Channel</th>
          <th>Node Count</th>
          <th>Data Representation & Description</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>Internal Vitals</strong></td>
          <td>5 nodes</td>
          <td>Health (%), Hunger (%), Thirst (%), Energy (%), Instinct (0 for Calm, 1 for Alert)</td>
        </tr>
        <tr>
          <td><strong>Environmental Threats</strong></td>
          <td>9 nodes</td>
          <td>Active hazards (Fire, Flood, Toxic Cloud, Deep Pit) on each of the 9 Moore tiles</td>
        </tr>
        <tr>
          <td><strong>Food Sustenance</strong></td>
          <td>9 nodes</td>
          <td>Edible nourishment (Plant vegetation or edible prey carcass) present on tile</td>
        </tr>
        <tr>
          <td><strong>Water Sources</strong></td>
          <td>9 nodes</td>
          <td>Drinkable freshwater pool detected on tile</td>
        </tr>
        <tr>
          <td><strong>Rival Animal Organisms</strong></td>
          <td>9 nodes</td>
          <td>Presence of other competing animal agents within perception range</td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2 id="hidden-layers">Processing & Hidden Layers</h2>
  <div class="grid-cards">
    <div class="card">
      <h3 class="card-title">Hidden Layer 1: 16 Neurons</h3>
      <p class="layer-pill">Activation: ReLU (Rectified Linear Unit)</p>
      <p class="card-desc">
        Computes high-level spatial abstractions from raw sensory tiles. Identifies corridors of safety and clusters of abundant nourishment.
      </p>
    </div>
    <div class="card">
      <h3 class="card-title">Hidden Layer 2: 12 Neurons</h3>
      <p class="layer-pill">Activation: ReLU (Rectified Linear Unit)</p>
      <p class="card-desc">
        Arbitrates conflicting biological imperatives (e.g. foraging near a spreading wildfire vs fleeing toward barren plains).
      </p>
    </div>
  </div>

  <h2 id="output-actions">Motor Output Actions</h2>
  <p>
    The output layer contains <strong>8 action nodes</strong>. The index with highest activation during forward propagation is selected for turn execution:
  </p>
  <div class="grid-cards">
    <div class="card">
      <h3 class="card-title">Cardinal Movement (4 Actions)</h3>
      <p class="card-desc">Move North, Move East, Move South, Move West. Advances 1 tile, incurring terrain movement energy cost.</p>
    </div>
    <div class="card">
      <h3 class="card-title">Biological Maintenance (3 Actions)</h3>
      <p class="card-desc">Eat / Forage (restores 40-50 hunger), Drink Water (restores 40 thirst), Rest (restores 40 energy).</p>
    </div>
    <div class="card">
      <h3 class="card-title">Combat Engagement (1 Action)</h3>
      <p class="card-desc">Attack / Defend. Strikes rival organism in adjacent tile, resolving via Strength and Agility checks.</p>
    </div>
  </div>

  <h2 id="genetic-algorithm">Evolutionary Algorithm Pipeline</h2>
  <p>{mlpEvolutionData.evolution.summary}</p>
  <div class="ea-pipeline">
    {mlpEvolutionData.evolution.steps.map((step) => (
      <div class="card ea-step-card">
        <div class="ea-step-header">
          <span class="ea-step-num">Step {step.step}</span>
          <h3 class="ea-step-title">{step.name}</h3>
        </div>
        <p class="ea-step-detail">{step.detail}</p>
      </div>
    ))}
  </div>

  <div class="figure-container">
    <img 
      src="/images/fitness_evolution_chart.png" 
      alt="EvoSim Multi-Generation Neuroevolution Convergence and Trait Adaptations" 
      class="figure-image"
      loading="lazy"
    />
    <div class="figure-caption">
      <span><strong>Figure 4.2:</strong> Generational analytics showing elite vs mean fitness convergence, species demographic ratios, and morphological trait divergence across generations.</span>
      <span class="badge">GA Telemetry</span>
    </div>
  </div>
</BaseLayout>

<style>
  .layer-pill {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent-bio);
    background: var(--accent-bio-subtle);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-xs);
    display: inline-block;
    margin-bottom: 0.75rem;
  }
  .card-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0 !important;
  }
  .ea-pipeline {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .ea-step-card {
    margin-bottom: 0;
    border-left: 3px solid var(--accent-neural);
  }
  .ea-step-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }
  .ea-step-num {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--accent-neural);
    background: var(--accent-neural-subtle);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-xs);
  }
  .ea-step-title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
  }
  .ea-step-detail {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0 !important;
  }
</style>
